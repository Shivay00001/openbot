{
  "name": "@openbot/shared-types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript types, DTOs, and API contracts for all OpenBot services",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "import": "./dist/index.js", "types": "./dist/index.d.ts" },
    "./api": { "import": "./dist/api.js", "types": "./dist/api.d.ts" },
    "./events": { "import": "./dist/events.js", "types": "./dist/events.d.ts" },
    "./dto": { "import": "./dist/dto.js", "types": "./dist/dto.d.ts" }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0"
  }
}

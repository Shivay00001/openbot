# ─────────────────────────────────────────────────────────────
# OpenBot — Environment Configuration
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ─── Database (PostgreSQL) ───────────────────────────────────
DATABASE_URL="postgresql://openbot:openbot_secret@localhost:5432/openbot?schema=public"

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT Authentication ─────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="change-this-refresh-secret-too"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── OAuth Providers (Optional) ─────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── Service Ports ───────────────────────────────────────────
API_GATEWAY_PORT=4000
AI_ENGINE_PORT=4001
REALTIME_SERVER_PORT=4002
TASK_RUNNER_PORT=4003
WEB_APP_PORT=3000

# ─── BYOK Cloud Provider Keys (User-level, stored encrypted) ─
# These are DEFAULTS for development only.
# In production, users supply their own keys via the Settings UI.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
XAI_API_KEY=""
DEEPSEEK_API_KEY=""
MISTRAL_API_KEY=""

# ─── Local Model Inference ───────────────────────────────────
OLLAMA_BASE_URL="http://localhost:11434"

# ─── Twilio (Voice Calls — Wajo AI Fo style) ────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ─── Search Provider ────────────────────────────────────────
BRAVE_SEARCH_API_KEY=""
TAVILY_API_KEY=""

# ─── Encryption ─────────────────────────────────────────────
ENCRYPTION_KEY="change-this-32-byte-hex-key-for-production"

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL="debug"
NODE_ENV="development"

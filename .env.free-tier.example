# ─────────────────────────────────────────────────────────────
# OpenBot — 100% FREE TIER ENVIRONMENT CONFIGURATION
# Zero Credit Card Required • $0.00 / Month Running Cost
# ─────────────────────────────────────────────────────────────

# ─── 1. Free Database (Choose Neon or Supabase) ───────────────
# Option A: Neon Serverless Postgres (Free 0.5GB, serverless autoscaling)
# Get free connection string at: https://neon.tech
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/openbot?sslmode=require"

# Option B: Supabase (Free 500MB PostgreSQL + pgvector)
# Get free connection string at: https://supabase.com
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ─── 2. Free Serverless Cache & Rate Limiting (Upstash) ──────
# Free 10,000 commands/day Redis at: https://upstash.com
REDIS_URL="rediss://default:your-token@your-region.upstash.io:6379"

# ─── 3. Free AI Inference Providers ──────────────────────────
# Option A: Groq Cloud (Ultra-Fast Free Tier: Llama 3.3 70B, DeepSeek R1)
# Sign up at: https://console.groq.com (Zero fees)
GROQ_API_KEY=""

# Option B: Google Gemini 2.0 / 2.5 Flash Free Tier (1,500 requests/day free)
# Sign up at: https://aistudio.google.com
GOOGLE_AI_API_KEY=""

# Option C: On-Device Ollama (100% Offline, Zero Cloud Cost)
OLLAMA_BASE_URL="http://localhost:11434"

# ─── 4. Free Web Hosting ──────────────────────────────────────
# Deploy to Vercel Hobby Plan (100% Free):
# Run: `npx vercel`
NEXT_PUBLIC_APP_URL="https://your-openbot.vercel.app"

# ─── 5. Security & Authentication ────────────────────────────
JWT_SECRET="generate-a-32-character-random-hex-string-here"
JWT_EXPIRES_IN="7d"
ENCRYPTION_KEY="32-byte-hex-encryption-key-for-storing-user-api-keys"

# ─── 6. Free Search Providers (Optional) ─────────────────────
# DuckDuckGo is used by default (No API key needed).
# Brave Search Free Tier (2,000 queries/month free): https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=""

NODE_ENV="production"
